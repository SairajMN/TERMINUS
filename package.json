{
  "name": "terminus",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "terminus": "bun apps/cli/src/main.ts",
    "gui": "bun apps/cli/src/main.ts --gui",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "fix": "biome check --write .",
    "benchmark": "bun scripts/benchmark.ts",
    "dist": "bun scripts/build-dist.ts",
    "release": "bun scripts/release.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.134.0",
    "openai": "^7.33.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@terminus/agent-runtime": "workspace:*",
    "@terminus/context-engine": "workspace:*",
    "@terminus/extension-host": "workspace:*",
    "@terminus/extension-sdk": "workspace:*",
    "@terminus/mcp-client": "workspace:*",
    "@terminus/model-gateway": "workspace:*",
    "@terminus/permission-engine": "workspace:*",
    "@terminus/runtime-bridge": "workspace:*",
    "@terminus/session-store": "workspace:*",
    "@terminus/shared": "workspace:*",
    "@terminus/tool-runtime": "workspace:*",
    "@terminus/workspace-ui": "workspace:*",
    "@types/bun": "^1.4.3",
    "typescript": "^7.0.2"
  }
}
